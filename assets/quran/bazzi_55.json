{"index": "055", "name": "Ar-Rahman", "verse": {"verse_0": "بِسۡمِ ٱللَّهِ ٱلرَّحۡمَٰنِ ٱلرَّحِيمِ", "verse_1": "ٱلرَّحۡمَٰنُ عَلَّمَ ٱلۡقُرَانَ", "verse_2": "خَلَقَ ٱلۡإِنسَٰنَ", "verse_3": "عَلَّمَهُ ٱلۡبَيَانَ", "verse_4": "ٱلشَّمۡسُ وَٱلۡقَمَرُ بِحُسۡبَانٖ", "verse_5": "وَٱلنَّجۡمُ وَٱلشَّجَرُ يَسۡجُدَانِ", "verse_6": "وَٱلسَّمَآءَ رَفَعَهَا وَوَضَعَ ٱلۡمِيزَانَ", "verse_7": "أَلَّا تَطۡغَوۡاْ فِي ٱلۡمِيزَانِ", "verse_8": "وَأَقِيمُواْ ٱلۡوَزۡنَ بِٱلۡقِسۡطِ وَلَا تُخۡسِرُواْ ٱلۡمِيزَانَ", "verse_9": "وَٱلۡأَرۡضَ وَضَعَهَا لِلۡأَنَامِ فِيهَا فَٰكِهَةٞ وَٱلنَّخۡلُ ذَاتُ ٱلۡأَكۡمَامِ", "verse_10": "وَٱلۡحَبُّ ذُو ٱلۡعَصۡفِ وَٱلرَّيۡحَانُ", "verse_11": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ", "verse_12": "خَلَقَ ٱلۡإِنسَٰنَ مِن صَلۡصَٰلٖ كَٱلۡفَخَّارِ", "verse_13": "وَخَلَقَ ٱلۡجَآنَّ مِن مَّارِجٖ مِّن نَّارٖ", "verse_14": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ", "verse_15": "رَبُّ ٱلۡمَشۡرِقَيۡنِ وَرَبُّ ٱلۡمَغۡرِبَيۡنِ", "verse_16": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ", "verse_17": "مَرَجَ ٱلۡبَحۡرَيۡنِ يَلۡتَقِيَانِ", "verse_18": "بَيۡنَهُمَا بَرۡزَخٞ لَّا يَبۡغِيَانِ", "verse_19": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ", "verse_20": "يَخۡرُجُ مِنۡهُمَا ٱللُّؤۡلُؤُ وَٱلۡمَرۡجَانُ", "verse_21": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ", "verse_22": "وَلَهُ ٱلۡجَوَارِ ٱلۡمُنشَـَٔاتُ فِي ٱلۡبَحۡرِ كَٱلۡأَعۡلَٰمِ", "verse_23": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ", "verse_24": "كُلُّ مَنۡ عَلَيۡهَا فَانٖ", "verse_25": "وَيَبۡقَىٰ وَجۡهُ رَبِّكَ ذُو ٱلۡجَلَٰلِ وَٱلۡإِكۡرَامِ", "verse_26": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ", "verse_27": "يَسۡـَٔلُهُۥ مَن فِي ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِۚ كُلَّ يَوۡمٍ هُوَ فِي شَأۡنٖ", "verse_28": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ", "verse_29": "سَنَفۡرُغُ لَكُمُۥ أَيُّهَ ٱلثَّقَلَانِ", "verse_30": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ", "verse_31": "يَٰمَعۡشَرَ ٱلۡجِنِّ وَٱلۡإِنسِ إِنِ ٱسۡتَطَعۡتُمُۥ أَن تَنفُذُواْ مِنۡ أَقۡطَارِ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِ فَٱنفُذُواْۚ لَا تَنفُذُونَ إِلَّا بِسُلۡطَٰنٖ", "verse_32": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ", "verse_33": "يُرۡسَلُ عَلَيۡكُمَا شِوَاظٞ مِّن نَّارٖ", "verse_34": "وَنُحَاسٖ فَلَا تَنتَصِرَانِ", "verse_35": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ", "verse_36": "فَإِذَا ٱنشَقَّتِ ٱلسَّمَآءُ فَكَانَتۡ وَرۡدَةٗ كَٱلدِّهَانِ", "verse_37": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ", "verse_38": "فَيَوۡمَئِذٖ لَّا يُسۡـَٔلُ عَن ذَنۢبِهِۦ إِنسٞ وَلَا جَآنّٞ", "verse_39": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ", "verse_40": "يُعۡرَفُ ٱلۡمُجۡرِمُونَ بِسِيمَٰهُمُۥ فَيُؤۡخَذُ بِٱلنَّوَٰصِي وَٱلۡأَقۡدَامِ", "verse_41": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ", "verse_42": "هَٰذِهِۦ جَهَنَّمُ ٱلَّتِي يُكَذِّبُ بِهَا ٱلۡمُجۡرِمُونَ", "verse_43": "يَطُوفُونَ بَيۡنَهَا وَبَيۡنَ حَمِيمٍ ءَانٖ", "verse_44": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ", "verse_45": "وَلِمَنۡ خَافَ مَقَامَ رَبِّهِۦ جَنَّتَانِ", "verse_46": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ", "verse_47": "ذَوَاتَا أَفۡنَانٖ", "verse_48": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ", "verse_49": "فِيهِمَا عَيۡنَانِ تَجۡرِيَانِ", "verse_50": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ", "verse_51": "فِيهِمَا مِن كُلِّ فَٰكِهَةٖ زَوۡجَانِ", "verse_52": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ", "verse_53": "مُتَّكِـِٔينَ عَلَىٰ فُرُشِۭ بَطَآئِنُهَا مِنۡ إِسۡتَبۡرَقٖۚ وَجَنَى ٱلۡجَنَّتَيۡنِ دَانٖ", "verse_54": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ", "verse_55": "فِيهِنَّ قَٰصِرَٰتُ ٱلطَّرۡفِ لَمۡ يَطۡمِثۡهُنَّ إِنسٞ قَبۡلَهُمُۥ وَلَا جَآنّٞ", "verse_56": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ", "verse_57": "كَأَنَّهُنَّ ٱلۡيَاقُوتُ وَٱلۡمَرۡجَانُ", "verse_58": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ", "verse_59": "هَلۡ جَزَآءُ ٱلۡإِحۡسَٰنِ إِلَّا ٱلۡإِحۡسَٰنُ", "verse_60": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ", "verse_61": "وَمِن دُونِهِمَا جَنَّتَانِ", "verse_62": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ", "verse_63": "مُدۡهَآمَّتَانِ", "verse_64": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ", "verse_65": "فِيهِمَا عَيۡنَانِ نَضَّاخَتَانِ", "verse_66": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ", "verse_67": "فِيهِمَا فَٰكِهَةٞ وَنَخۡلٞ وَرُمَّانٞ", "verse_68": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ", "verse_69": "فِيهِنَّ خَيۡرَٰتٌ حِسَانٞ", "verse_70": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ", "verse_71": "حُورٞ مَّقۡصُورَٰتٞ فِي ٱلۡخِيَامِ", "verse_72": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ", "verse_73": "لَمۡ يَطۡمِثۡهُنَّ إِنسٞ قَبۡلَهُمُۥ وَلَا جَآنّٞ", "verse_74": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ", "verse_75": "مُتَّكِـِٔينَ عَلَىٰ رَفۡرَفٍ خُضۡرٖ وَعَبۡقَرِيٍّ حِسَانٖ", "verse_76": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ", "verse_77": "تَبَٰرَكَ ٱسۡمُ رَبِّكَ ذِي ٱلۡجَلَٰلِ وَٱلۡإِكۡرَامِ"}, "count": 77}