{"index": "087", "name": "Al-A'la", "verse": {"verse_0": "بِسۡمِ اِ۬للَّهِ اِ۬لرَّحۡمَٰنِ اِ۬لرَّحِيمِ", "verse_1": "سَبِّحِ اِ۪سۡمَ رَبِّكَ اَ۬لۡأَعۡلَى", "verse_2": "اَ۬لَّذِي خَلَقَ فَسَوّۭيٰ", "verse_3": "وَاَلَّذِي قَدَّرَ فَهَدۭيٰ", "verse_4": "وَاَلَّذِيٓ أَخۡرَجَ اَ۬لۡمَرۡعۭيٰ", "verse_5": "فَجَعَلَهُۥ غُثَآءً أَحۡوۭيٰ", "verse_6": "سَنُقۡرِئُكَ فَلَا تَنسۭيٰٓ", "verse_7": "إِلَّا مَا شَآءَ اَ۬للَّهُۚ إِنَّهُۥ يَعۡلَمُ اُ۬لۡجَهۡرَ وَمَا يَخۡفۭيٰ", "verse_8": "وَنُيَسِّرُكَ لِلۡيُسۡر۪يٰ", "verse_9": "فَذَكِّرۡ إِن نَّفَعَتِ اِ۬لذِّكۡر۪يٰ", "verse_10": "سَيَذَّكَّرُ مَن يَخۡشۭيٰ", "verse_11": "وَيَتَجَنَّبُهَا اَ۬لۡأَشۡقَى", "verse_12": "اَ۬لَّذِي يَصۡلَى اَ۬لنَّارَ اَ۬لۡكُبۡر۪يٰ", "verse_13": "ثُمَّ لَا يَمُوتُ فِيهَا وَلَا يَحۡيۭيٰ", "verse_14": "قَدۡ أَفۡلَحَ مَن تَزَكّۭيٰ", "verse_15": "وَذَكَرَ اَ۪سۡمَ رَبِّهِۦ فَصَلّۭيٰ", "verse_16": "بَلۡ يُؤۡثِرُونَ اَ۬لۡحَيَوٰةَ اَ۬لدُّنۡيۭا", "verse_17": "وَاَلۡأٓخِرَةُ خَيۡرٞ وَأَبۡقۭيٰٓ", "verse_18": "إِنَّ هَٰذَا لَفِي اِ۬لصُّحُفِ اِ۬لۡأُولۭيٰ", "verse_19": "صُحُفِ إِبۡرَٰهِيمَ وَمُوسۭيٰ"}, "count": 19}