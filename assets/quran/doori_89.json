{"index": "089", "name": "Al-Fajr", "verse": {"verse_0": "بِسۡمِ اِ۬للَّهِ اِ۬لرَّحۡمَٰنِ اِ۬لرَّحِيمِ", "verse_1": "وَاَلۡفَجۡرِ", "verse_2": "وَلَيَالٍ عَشۡرٖ", "verse_3": "وَاَلشَّفۡعِ وَاَلۡوَتۡرِ", "verse_4": "وَاَلَّيۡلِ إِذَا يَسۡرِۦ", "verse_5": "هَلۡ فِي ذَٰلِكَ قَسَمٞ لِّذِي حِجۡرٍ", "verse_6": "أَلَمۡ تَرَ كَيۡفَ فَعَلَ رَبُّكَ بِعَادٍ", "verse_7": "إِرَمَ ذَاتِ اِ۬لۡعِمَادِ", "verse_8": "اِ۬لَّتِي لَمۡ يُخۡلَقۡ مِثۡلُهَا فِي اِ۬لۡبِلَٰدِ", "verse_9": "وَثَمُودَ اَ۬لَّذِينَ جَابُواْ اُ۬لصَّخۡرَ بِالۡوَادِ", "verse_10": "وَفِرۡعَوۡنَ ذِي اِ۬لۡأَوۡتَادِ", "verse_11": "اِ۬لَّذِينَ طَغَوۡاْ فِي اِ۬لۡبِلَٰدِ", "verse_12": "فَأَكۡثَرُواْ فِيهَا اَ۬لۡفَسَادَ", "verse_13": "فَصَبَّ عَلَيۡهِمۡ رَبُّكَ سَوۡطَ عَذَابٍ", "verse_14": "إِنَّ رَبَّكَ لَبِالۡمِرۡصَادِ", "verse_15": "فَأَمَّا اَ۬لۡإِنسَٰنُ إِذَا مَا اَ۪بۡتَلَىٰهُ رَبُّهُۥ فَأَكۡرَمَهُۥ وَنَعَّمَهُۥ", "verse_16": "فَيَقُولُ رَبِّيَ أَكۡرَمَنِۦ", "verse_17": "وَأَمَّآ إِذَا مَا اَ۪بۡتَلَىٰهُ فَقَدَرَ عَلَيۡهِ رِزۡقَهُۥ", "verse_18": "فَيَقُولُ رَبِّيَ أَهَٰنَنِۦ", "verse_19": "كَلَّاۖ بَل لَّا يُكۡرِمُونَ اَ۬لۡيَتِيمَ", "verse_20": "وَلَا يَحُضُّونَ عَلَىٰ طَعَامِ اِ۬لۡمِسۡكِينِ", "verse_21": "وَيَأۡكُلُونَ اَ۬لتُّرَاثَ أَكۡلٗا لَّمّٗا", "verse_22": "وَيُحِبُّونَ اَ۬لۡمَالَ حُبّٗا جَمّٗا", "verse_23": "كَلَّآ إِذَا دُكَّتِ اِ۬لۡأَرۡضُ دَكّٗا دَكّٗا", "verse_24": "وَجَآءَ رَبُّكَ وَاَلۡمَلَكُ صَفّٗا صَفّٗا", "verse_25": "وَجِاْيٓءَ يَوۡمَئِذِۢ بِجَهَنَّمَ", "verse_26": "يَوۡمَئِذٖ يَتَذَكَّرُ اُ۬لۡإِنسَٰنُ وَأَنّۭيٰ لَهُ اُ۬لذِّكۡر۪يٰ", "verse_27": "يَقُولُ يَٰلَيۡتَنِي قَدَّمۡتُ لِحَيَاتِي", "verse_28": "فَيَوۡمَئِذٖ لَّا يُعَذِّبُ عَذَابَهُۥٓ أَحَدٞ", "verse_29": "وَلَا يُوثِقُ وَثَاقَهُۥٓ أَحَدٞ", "verse_30": "يَٰٓأَيَّتُهَا اَ۬لنَّفۡسُ اُ۬لۡمُطۡمَئِنَّةُ", "verse_31": "اُ۪رۡجِعِيٓ إِلَىٰ رَبِّكِ رَاضِيَةٗ مَّرۡضِيَّةٗ", "verse_32": "فَاَدۡخُلِي فِي عِبَٰدِي وَاَدۡخُلِي جَنَّتِي"}, "count": 32}