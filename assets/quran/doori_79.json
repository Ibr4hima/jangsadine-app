{"index": "079", "name": "An-Nazi'at", "verse": {"verse_0": "بِسۡمِ اِ۬للَّهِ اِ۬لرَّحۡمَٰنِ اِ۬لرَّحِيمِ", "verse_1": "وَاَلنَّٰزِعَٰتِ غَرۡقٗا", "verse_2": "وَاَلنَّٰشِطَٰتِ نَشۡطٗا", "verse_3": "وَاَلسَّٰبِحَٰتِ سَبۡحٗا", "verse_4": "فَاَلسَّٰبِقَٰتِ سَبۡقٗا", "verse_5": "فَاَلۡمُدَبِّرَٰتِ أَمۡرٗا", "verse_6": "يَوۡمَ تَرۡجُفُ اُ۬لرَّاجِفَةُ", "verse_7": "تَتۡبَعُهَا اَ۬لرَّادِفَةُ", "verse_8": "قُلُوبٞ يَوۡمَئِذٖ وَاجِفَةٌ", "verse_9": "أَبۡصَٰرُهَا خَٰشِعَةٞ", "verse_10": "يَقُولُونَ أَٰ۟نَّا لَمَرۡدُودُونَ فِي اِ۬لۡحَافِرَةِ", "verse_11": "أَٰ۟ذَا كُنَّا عِظَٰمٗا نَّخِرَةٗ", "verse_12": "قَالُواْ تِلۡكَ إِذٗا كَرَّةٌ خَاسِرَةٞ", "verse_13": "فَإِنَّمَا هِيَ زَجۡرَةٞ وَٰحِدَةٞ", "verse_14": "فَإِذَا هُم بِالسَّاهِرَةِ", "verse_15": "هَلۡ أَتَىٰكَ حَدِيثُ مُوسۭيٰٓ", "verse_16": "إِذۡ نَادَىٰهُ رَبُّهُۥ بِالۡوَادِ اِ۬لۡمُقَدَّسِ طُوَى", "verse_17": "اَ۪ذۡهَبۡ إِلَىٰ فِرۡعَوۡنَ إِنَّهُۥ طَغۭيٰ", "verse_18": "فَقُلۡ هَل لَّكَ إِلَىٰٓ أَن تَزَكّۭيٰ", "verse_19": "وَأَهۡدِيَكَ إِلَىٰ رَبِّكَ فَتَخۡشۭيٰ", "verse_20": "فَأَر۪ىٰهُ اُ۬لۡأٓيَةَ اَ۬لۡكُبۡر۪يٰ", "verse_21": "فَكَذَّبَ وَعَصۭيٰ", "verse_22": "ثُمَّ أَدۡبَرَ يَسۡعۭيٰ", "verse_23": "فَحَشَرَ فَنَادۭيٰ", "verse_24": "فَقَالَ أَنَا۠ رَبُّكُمُ اُ۬لۡأَعۡلۭيٰ", "verse_25": "فَأَخَذَهُ اُ۬للَّهُ نَكَالَ اَ۬لۡأٓخِرَةِ وَاَلۡأُولۭيٰٓ", "verse_26": "إِنَّ فِي ذَٰلِكَ لَعِبۡرَةٗ لِّمَن يَخۡشۭيٰٓ", "verse_27": "ءَٰا۬نتُمۡ أَشَدُّ خَلۡقًا أَمِ اِ۬لسَّمَآءُۚ بَنۭىٰهَا", "verse_28": "رَفَعَ سَمۡكَهَا فَسَوّۭىٰهَا", "verse_29": "وَأَغۡطَشَ لَيۡلَهَا وَأَخۡرَجَ ضُحۭىٰهَا", "verse_30": "وَاَلۡأَرۡضَ بَعۡدَ ذَٰلِكَ دَحۭىٰهَآ", "verse_31": "أَخۡرَجَ مِنۡهَا مَآءَهَا وَمَرۡعۭىٰهَا", "verse_32": "وَاَلۡجِبَالَ أَرۡسۭىٰهَا", "verse_33": "مَتَٰعٗا لَّكُمۡ وَلِأَنۡعَٰمِكُمۡ", "verse_34": "فَإِذَا جَآءَتِ اِ۬لطَّآمَّةُ اُ۬لۡكُبۡر۪يٰ", "verse_35": "يَوۡمَ يَتَذَكَّرُ اُ۬لۡإِنسَٰنُ مَا سَعۭيٰ", "verse_36": "وَبُرِّزَتِ اِ۬لۡجَحِيمُ لِمَن يَر۪يٰ", "verse_37": "فَأَمَّا مَن طَغَىٰ وَءَاثَرَ اَ۬لۡحَيَوٰةَ اَ۬لدُّنۡيۭا", "verse_38": "فَإِنَّ اَ۬لۡجَحِيمَ هِيَ اَ۬لۡمَأۡوۭيٰ", "verse_39": "وَأَمَّا مَنۡ خَافَ مَقَامَ رَبِّهِۦ وَنَهَى اَ۬لنَّفۡسَ عَنِ اِ۬لۡهَوۭيٰ", "verse_40": "فَإِنَّ اَ۬لۡجَنَّةَ هِيَ اَ۬لۡمَأۡوۭيٰ", "verse_41": "۞ يَسۡـَٔلُونَكَ عَنِ اِ۬لسَّاعَةِ أَيَّانَ مُرۡسۭىٰهَا", "verse_42": "فِيمَ أَنتَ مِن ذِكۡر۪ىٰهَآ", "verse_43": "إِلَىٰ رَبِّكَ مُنتَهۭىٰهَآ", "verse_44": "إِنَّمَآ أَنتَ مُنذِرُ مَن يَخۡشۭىٰهَا", "verse_45": "كَأَنَّهُمۡ يَوۡمَ يَرَوۡنَهَا لَمۡ يَلۡبَثُوٓاْ إِلَّا عَشِيَّةً أَوۡ ضُحۭىٰهَا"}, "count": 45}