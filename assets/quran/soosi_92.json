{"index": "092", "name": "Al-Layl", "verse": {"verse_0": "بِسۡمِ اِ۬للَّهِ اِ۬لرَّحۡمَٰنِ اِ۬لرَّحِيمِ", "verse_1": "وَاَلَّيۡلِ إِذَا يَغۡشۭيٰ", "verse_2": "وَاَلنَّه۪ارِ إِذَا تَجَلّۭيٰ", "verse_3": "وَمَا خَلَقَ اَ۬لذَّكَرَ وَاَلۡأُنثۭيٰ", "verse_4": "إِنَّ سَعۡيَكُمۡ لَشَتّۭيٰ", "verse_5": "فَأَمَّا مَنۡ أَعۡطَىٰ وَاَتَّقۭيٰ", "verse_6": "وَصَدَّقَ بِالۡحُسۡنۭيٰ", "verse_7": "فَسَنُيَسِّرُهُۥ لِلۡيُسۡر۪يٰ", "verse_8": "وَأَمَّا مَنۢ بَخِلَ وَاَسۡتَغۡنۭيٰ", "verse_9": "وَكَذَّب بِّالۡحُسۡنۭيٰ", "verse_10": "فَسَنُيَسِّرُهُۥ لِلۡعُسۡر۪يٰ", "verse_11": "وَمَا يُغۡنِي عَنۡهُ مَالُهُۥ إِذَا تَرَدّۭيٰ", "verse_12": "إِنَّ عَلَيۡنَا لَلۡهُدۭيٰ", "verse_13": "وَإِنَّ لَنَا لَلۡأٓخِرَةَ وَاَلۡأُولۭيٰ", "verse_14": "فَأَنذَرۡتُكُمۡ نَارٗا تَلَظّۭيٰ", "verse_15": "لَا يَصۡلَىٰهَا إِلَّا اَ۬لۡأَشۡقَى", "verse_16": "اَ۬لَّذِي كَذَّبَ وَتَوَلّۭيٰ", "verse_17": "وَسَيُجَنَّبُهَا اَ۬لۡأَتۡقَى", "verse_18": "اَ۬لَّذِي يُوتِي مَالَهُۥ يَتَزَكّۭيٰ", "verse_19": "وَمَا لِأَحَدٍ عِندَهُۥ مِن نِّعۡمَةٖ تُجۡزۭيٰ", "verse_20": "إِلَّا اَ۪بۡتِغَآءَ وَجۡهِ رَبِّهِ اِ۬لۡأَعۡلۭيٰ", "verse_21": "وَلَسَوۡفَ يَرۡضۭيٰ"}, "count": 21}