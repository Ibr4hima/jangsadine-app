{"index": "096", "name": "Al-'Alaq", "verse": {"verse_0": "بِسۡمِ اِ۬للَّهِ اِ۬لرَّحۡمَٰنِ اِ۬لرَّحِيمِ", "verse_1": "اِ۪قۡرَأۡ بِاسۡمِ رَبِّكَ اَ۬لَّذِي خَلَقَ", "verse_2": "خَلَقَ اَ۬لۡإِنسَٰنَ مِنۡ عَلَقٍ", "verse_3": "اِ۪قۡرَأۡ وَرَبُّكَ اَ۬لۡأَكۡرَمُ", "verse_4": "اُ۬لَّذِي عَلَّم بِالۡقَلَمِ", "verse_5": "عَلَّمَ اَ۬لۡإِنسَٰنَ مَا لَمۡ يَعۡلَمۡ", "verse_6": "كَلَّا إِنَّ اَ۬لۡإِنسَٰنَ لَيَطۡغۭيٰ", "verse_7": "أَن رَّء۪اهُ اُ۪سۡتَغۡنۭيٰ", "verse_8": "إِنَّ إِلَىٰ رَبِّكَ اَ۬لرُّجۡعۭيٰ", "verse_9": "أَرَءَيۡتَ اَ۬لَّذِي يَنۡهۭيٰ", "verse_10": "عَبۡدًا إِذَا صَلّۭيٰ", "verse_11": "أَرَءَيۡتَ إِن كَانَ عَلَى اَ۬لۡهُدۭيٰ", "verse_12": "أَوۡ أَمَرَ بِالتَّقۡوۭيٰ", "verse_13": "أَرَءَيۡتَ إِن كَذَّبَ وَتَوَلّۭيٰ", "verse_14": "أَلَمۡ يَعۡلَم بِأَنَّ اَ۬للَّهَ يَر۪يٰ", "verse_15": "كَلَّا لَئِن لَّمۡ يَنتَهِ", "verse_16": "لَنَسۡفَعَۢا بِالنَّاصِيَةِ", "verse_17": "نَاصِيَةٖ كَٰذِبَةٍ خَاطِئَةٖ", "verse_18": "فَلۡيَدۡعُ نَادِيَهُۥ", "verse_19": "سَنَدۡعُ اُ۬لزَّبَانِيَةَ", "verse_20": "كَلَّا لَا تُطِعۡهُ وَاَسۡجُدۡۤ وَاَقۡتَرِب۩"}, "count": 20}