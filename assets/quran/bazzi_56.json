{"index": "056", "name": "Al-Waqi'ah", "verse": {"verse_0": "بِسۡمِ ٱللَّهِ ٱلرَّحۡمَٰنِ ٱلرَّحِيمِ", "verse_1": "إِذَا وَقَعَتِ ٱلۡوَاقِعَةُ", "verse_2": "لَيۡسَ لِوَقۡعَتِهَا كَاذِبَةٌ", "verse_3": "خَافِضَةٞ رَّافِعَةٌ", "verse_4": "إِذَا رُجَّتِ ٱلۡأَرۡضُ رَجّٗا", "verse_5": "وَبُسَّتِ ٱلۡجِبَالُ بَسّٗا", "verse_6": "فَكَانَتۡ هَبَآءٗ مُّنۢبَثّٗا", "verse_7": "وَكُنتُمُۥ أَزۡوَٰجٗا ثَلَٰثَةٗ", "verse_8": "فَأَصۡحَٰبُ ٱلۡمَيۡمَنَةِ", "verse_9": "مَا أَصۡحَٰبُ ٱلۡمَيۡمَنَةِ", "verse_10": "وَأَصۡحَٰبُ ٱلۡمَشۡـَٔمَةِ", "verse_11": "مَا أَصۡحَٰبُ ٱلۡمَشۡـَٔمَةِ", "verse_12": "وَٱلسَّٰبِقُونَ ٱلسَّٰبِقُونَ", "verse_13": "أُوْلَٰٓئِكَ ٱلۡمُقَرَّبُونَ", "verse_14": "فِي جَنَّٰتِ ٱلنَّعِيمِ", "verse_15": "ثُلَّةٞ مِّنَ ٱلۡأَوَّلِينَ", "verse_16": "وَقَلِيلٞ مِّنَ ٱلۡأٓخِرِينَ", "verse_17": "عَلَىٰ سُرُرٖ مَّوۡضُونَةٖ", "verse_18": "مُّتَّكِـِٔينَ عَلَيۡهَا مُتَقَٰبِلِينَ", "verse_19": "يَطُوفُ عَلَيۡهِمُۥ وِلۡدَٰنٞ مُّخَلَّدُونَ", "verse_20": "بِأَكۡوَابٖ وَأَبَارِيقَ", "verse_21": "وَكَأۡسٖ مِّن مَّعِينٖ", "verse_22": "لَّا يُصَدَّعُونَ عَنۡهَا وَلَا يُنزَفُونَ", "verse_23": "وَفَٰكِهَةٖ مِّمَّا يَتَخَيَّرُونَ", "verse_24": "وَلَحۡمِ طَيۡرٖ مِّمَّا يَشۡتَهُونَ", "verse_25": "وَحُورٌ عِينٞ كَأَمۡثَٰلِ ٱللُّؤۡلُوِٕ ٱلۡمَكۡنُونِ", "verse_26": "جَزَآءَۢ بِمَا كَانُواْ يَعۡمَلُونَ", "verse_27": "لَا يَسۡمَعُونَ فِيهَا لَغۡوٗا وَلَا تَأۡثِيمًا إِلَّا قِيلٗا سَلَٰمٗا سَلَٰمٗا", "verse_28": "وَأَصۡحَٰبُ ٱلۡيَمِينِ", "verse_29": "مَا أَصۡحَٰبُ ٱلۡيَمِينِ", "verse_30": "فِي سِدۡرٖ مَّخۡضُودٖ", "verse_31": "وَطَلۡحٖ مَّنضُودٖ", "verse_32": "وَظِلّٖ مَّمۡدُودٖ", "verse_33": "وَمَآءٖ مَّسۡكُوبٖ", "verse_34": "وَفَٰكِهَةٖ كَثِيرَةٖ", "verse_35": "لَّا مَقۡطُوعَةٖ وَلَا مَمۡنُوعَةٖ", "verse_36": "وَفُرُشٖ مَّرۡفُوعَةٍ", "verse_37": "إِنَّا أَنشَأۡنَٰهُنَّ إِنشَآءٗ", "verse_38": "فَجَعَلۡنَٰهُنَّ أَبۡكَارًا", "verse_39": "عُرُبًا أَتۡرَابٗا", "verse_40": "لِّأَصۡحَٰبِ ٱلۡيَمِينِ", "verse_41": "ثُلَّةٞ مِّنَ ٱلۡأَوَّلِينَ", "verse_42": "وَثُلَّةٞ مِّنَ ٱلۡأٓخِرِينَ", "verse_43": "وَأَصۡحَٰبُ ٱلشِّمَالِ", "verse_44": "مَا أَصۡحَٰبُ ٱلشِّمَالِ", "verse_45": "فِي سَمُومٖ وَحَمِيمٖ وَظِلّٖ مِّن يَحۡمُومٖ", "verse_46": "لَّا بَارِدٖ وَلَا كَرِيمٍ", "verse_47": "إِنَّهُمُۥ كَانُواْ قَبۡلَ ذَٰلِكَ مُتۡرَفِينَ", "verse_48": "وَكَانُواْ يُصِرُّونَ عَلَى ٱلۡحِنثِ ٱلۡعَظِيمِ", "verse_49": "وَكَانُواْ يَقُولُونَ", "verse_50": "أَى۪ذَا مُتۡنَا وَكُنَّا تُرَابٗا وَعِظَٰمًا أَ۟نَّا لَمَبۡعُوثُونَ", "verse_51": "أَوَءَابَآؤُنَا ٱلۡأَوَّلُونَ", "verse_52": "قُلۡ إِنَّ ٱلۡأَوَّلِينَ وَٱلۡأٓخِرِينَ", "verse_53": "لَمَجۡمُوعُونَ إِلَىٰ مِيقَٰتِ يَوۡمٖ مَّعۡلُومٖ", "verse_54": "ثُمَّ إِنَّكُمُۥ أَيُّهَا ٱلضَّآلُّونَ ٱلۡمُكَذِّبُونَ", "verse_55": "لَأٓكِلُونَ مِن شَجَرٖ مِّن زَقُّومٖ", "verse_56": "فَمَالِـُٔونَ مِنۡهَا ٱلۡبُطُونَ", "verse_57": "فَشَٰرِبُونَ عَلَيۡهِۦ مِنَ ٱلۡحَمِيمِ", "verse_58": "فَشَٰرِبُونَ شَرۡبَ ٱلۡهِيمِ", "verse_59": "هَٰذَا نُزُلُهُمُۥ يَوۡمَ ٱلدِّينِ", "verse_60": "نَحۡنُ خَلَقۡنَٰكُمُۥ فَلَوۡلَا تُصَدِّقُونَ", "verse_61": "أَفَرَءَيۡتُمُۥ مَا تُمۡنُونَ", "verse_62": "ءَا۬نتُمُۥ تَخۡلُقُونَهُۥ أَمۡ نَحۡنُ ٱلۡخَٰلِقُونَ", "verse_63": "نَحۡنُ قَدَرۡنَا بَيۡنَكُمُ ٱلۡمَوۡتَ وَمَا نَحۡنُ بِمَسۡبُوقِينَ", "verse_64": "عَلَىٰ أَن نُّبَدِّلَ أَمۡثَٰلَكُمُۥ وَنُنشِئَكُمُۥ فِي مَا لَا تَعۡلَمُونَ", "verse_65": "وَلَقَدۡ عَلِمۡتُمُ ٱلنَّشَآءَةَ ٱلۡأُولَىٰ فَلَوۡلَا تَذَّكَّرُونَ", "verse_66": "أَفَرَءَيۡتُمُۥ مَا تَحۡرُثُونَ", "verse_67": "ءَا۬نتُمُۥ تَزۡرَعُونَهُۥ أَمۡ نَحۡنُ ٱلزَّٰرِعُونَ", "verse_68": "لَوۡ نَشَآءُ لَجَعَلۡنَٰهُۥ حُطَٰمٗا فَظَلۡتُمُۥ تَفَكَّهُونَ", "verse_69": "إِنَّا لَمُغۡرَمُونَ", "verse_70": "بَلۡ نَحۡنُ مَحۡرُومُونَ", "verse_71": "أَفَرَءَيۡتُمُ ٱلۡمَآءَ ٱلَّذِي تَشۡرَبُونَ", "verse_72": "ءَا۬نتُمُۥ أَنزَلۡتُمُوهُۥ مِنَ ٱلۡمُزۡنِ أَمۡ نَحۡنُ ٱلۡمُنزِلُونَ", "verse_73": "لَوۡ نَشَآءُ جَعَلۡنَٰهُۥ أُجَاجٗا فَلَوۡلَا تَشۡكُرُونَ", "verse_74": "أَفَرَءَيۡتُمُ ٱلنَّارَ ٱلَّتِي تُورُونَ", "verse_75": "ءَا۬نتُمُۥ أَنشَأۡتُمُۥ شَجَرَتَهَا أَمۡ نَحۡنُ ٱلۡمُنشِـُٔونَ", "verse_76": "نَحۡنُ جَعَلۡنَٰهَا تَذۡكِرَةٗ وَمَتَٰعٗا لِّلۡمُقۡوِينَ", "verse_77": "فَسَبِّحۡ بِٱسۡمِ رَبِّكَ ٱلۡعَظِيمِ", "verse_78": "۞فَلَا أُقۡسِمُ بِمَوَٰقِعِ ٱلنُّجُومِ", "verse_79": "وَإِنَّهُۥ لَقَسَمٞ لَّوۡ تَعۡلَمُونَ عَظِيمٌ", "verse_80": "إِنَّهُۥ لَقُرَانٞ كَرِيمٞ", "verse_81": "فِي كِتَٰبٖ مَّكۡنُونٖ", "verse_82": "لَّا يَمَسُّهُۥ إِلَّا ٱلۡمُطَهَّرُونَ", "verse_83": "تَنزِيلٞ مِّن رَّبِّ ٱلۡعَٰلَمِينَ", "verse_84": "أَفَبِهَٰذَا ٱلۡحَدِيثِ أَنتُمُۥ مُدۡهِنُونَ", "verse_85": "وَتَجۡعَلُونَ رِزۡقَكُمُۥ أَنَّكُمُۥ تُكَذِّبُونَ", "verse_86": "فَلَوۡلَا إِذَا بَلَغَتِ ٱلۡحُلۡقُومَ", "verse_87": "وَأَنتُمُۥ حِينَئِذٖ تَنظُرُونَ", "verse_88": "وَنَحۡنُ أَقۡرَبُ إِلَيۡهِۦ مِنكُمُۥ وَلَٰكِن لَّا تُبۡصِرُونَ", "verse_89": "فَلَوۡلَا إِن كُنتُمُۥ غَيۡرَ مَدِينِينَ", "verse_90": "تَرۡجِعُونَهَا إِن كُنتُمُۥ صَٰدِقِينَ", "verse_91": "فَأَمَّا إِن كَانَ مِنَ ٱلۡمُقَرَّبِينَ", "verse_92": "فَرَوۡحٞ وَرَيۡحَانٞ وَجَنَّتُ نَعِيمٖ", "verse_93": "وَأَمَّا إِن كَانَ مِنۡ أَصۡحَٰبِ ٱلۡيَمِينِ", "verse_94": "فَسَلَٰمٞ لَّكَ مِنۡ أَصۡحَٰبِ ٱلۡيَمِينِ", "verse_95": "وَأَمَّا إِن كَانَ مِنَ ٱلۡمُكَذِّبِينَ ٱلضَّآلِّينَ", "verse_96": "فَنُزُلٞ مِّنۡ حَمِيمٖ", "verse_97": "وَتَصۡلِيَةُ جَحِيمٍ", "verse_98": "إِنَّ هَٰذَا لَهُوَ حَقُّ ٱلۡيَقِينِ", "verse_99": "فَسَبِّحۡ بِٱسۡمِ رَبِّكَ ٱلۡعَظِيمِ"}, "count": 99}